# auxfilsdesidees.fr : la page des projets, fichiers statiques (installée par deploy.sh dans ~/vigie/sites/ du serveur Vigie).
# Caddy de Vigie importe /etc/caddy/sites/*.caddy ; le dossier ~/vigie/sites y est monté en lecture seule.
auxfilsdesidees.fr {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	@ecriture not method GET HEAD
	respond @ecriture 405
	@fixes path /assets/*
	header @fixes Cache-Control "public, max-age=604800"
	@pages not path /assets/* /prive /prive/*
	header @pages Cache-Control "public, max-age=3600"
	root * /etc/caddy/sites/auxfilsdesidees
	file_server

	# Console privée du trafic GitHub (code dans le dépôt privé Axellum/trafic-github, fichiers dans ~/vigie/sites/afdi-prive,
	# dossier à part : deploy.sh remplace celui du site public en entier). Mot de passe, ni indexée ni gardée en cache.
	# Le hash bcrypt vient de ~/vigie/caddy.env (AFDI_PRIVE_HASH), jamais du dépôt.
	redir /prive /prive/ permanent
	handle_path /prive/* {
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		basic_auth {
			axel {$AFDI_PRIVE_HASH}
		}
		root * /etc/caddy/sites/afdi-prive
		file_server
	}

	handle_errors {
		# La réponse d'erreur garde l'invitation au mot de passe, sinon le navigateur ne la demande pas.
		@auth expression `{err.status_code} == 401`
		header @auth WWW-Authenticate `Basic realm="restricted"`
		header @auth X-Robots-Tag "noindex, nofollow"
		respond "{err.status_code}" {err.status_code}
	}
}

# En http comme en https : une seule redirection vers https://auxfilsdesidees.fr, au lieu de deux.
www.auxfilsdesidees.fr, http://www.auxfilsdesidees.fr {
	redir https://auxfilsdesidees.fr{uri} permanent
}
